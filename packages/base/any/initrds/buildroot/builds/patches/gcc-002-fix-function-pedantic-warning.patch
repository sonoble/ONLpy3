Fix ISO C pedantic warning for __FUNCTION__ in GCC 4.7.2

GCC 4.7.2 uses the non-standard __FUNCTION__ identifier in the gcc_assert
and gcc_unreachable macros which triggers pedantic warnings when building
with -Wpedantic. Replace with the ISO C99 standard __func__ identifier.

This fixes warnings like:
semantics.c:5492:804: warning: ISO C does not support '__FUNCTION__'
predefined identifier [-Wpedantic]

Signed-off-by: Claude Code <noreply@anthropic.com>

--- a/gcc/system.h
+++ b/gcc/system.h
@@ -671,7 +671,7 @@
 /* Use gcc_assert(EXPR) to test invariants.  */
 #if ENABLE_ASSERT_CHECKING
 #define gcc_assert(EXPR) 						\
-   ((void)(!(EXPR) ? fancy_abort (__FILE__, __LINE__, __FUNCTION__), 0 : 0))
+   ((void)(!(EXPR) ? fancy_abort (__FILE__, __LINE__, __func__), 0 : 0))
 #elif (GCC_VERSION >= 4005)
 #define gcc_assert(EXPR) 						\
   ((void)(__builtin_expect(!(EXPR), 0) ? __builtin_unreachable(), 0 : 0))
@@ -691,7 +691,7 @@
    unreachable default case of a switch.  Do not use gcc_assert(0).  */
 #if (GCC_VERSION >= 4005) && !ENABLE_ASSERT_CHECKING
 #define gcc_unreachable() __builtin_unreachable()
 #else
-#define gcc_unreachable() (fancy_abort (__FILE__, __LINE__, __FUNCTION__))
+#define gcc_unreachable() (fancy_abort (__FILE__, __LINE__, __func__))
 #endif

