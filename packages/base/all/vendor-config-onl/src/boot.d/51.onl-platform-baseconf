import sys
from onl.platform.baseconfig import baseconfig
from onl.platform.current import OnlPlatform

# Set up platform symlinks and base config
baseconfig()

# Run platform-specific initialization
try:
    platform = OnlPlatform()
    platform.baseconfig()
except Exception as e:
    # Log error but don't fail boot
    sys.stderr.write("Warning: Platform-specific initialization failed: %s\n" % str(e))



