#!/bin/sh -e
#
# rc.local
#
# This script is executed at the end of each multiuser runlevel.
# Make sure that the script will "exit 0" on success or any other
# value on error.
#
# In order to enable or disable this script just change the execution
# bits.

# Initialize ONL platform hardware (runs after all modules are loaded)
/usr/bin/python -c "from onl.platform.current import OnlPlatform; p = OnlPlatform(); p.baseconfig()" 2>&1 | logger -t onl-platform-init

exit 0
